# انسخ هذا الملف باسم .env واملأ القيم الحقيقية قبل التشغيل.
# لا تضع أي مفتاح فعلي داخل .env.example أو داخل Git.

# للتطوير المحلي البسيط: SQLite (لا حاجة لتثبيت أي شيء إضافي).
DATABASE_URL=sqlite:///./ai_study.db
# للإنتاج: استبدلها برابط PostgreSQL — مُختبَر فعليًا وجاهز، فقط بدّل السطر:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_study_db
# (يحتاج تثبيت psycopg2-binary، موجود أصلًا في requirements.txt)

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# مفتاح Gemini المجاني — احصل عليه من https://aistudio.google.com/apikey
# (دقيقتان، لا يحتاج بطاقة بنكية). لا تصل هذه القيمة أبدًا لتطبيق Flutter (§30).
GEMINI_API_KEY=

# اختياري: Redis لمشاركة Rate Limiting عبر عدة نسخ من السيرفر في الإنتاج.
# اتركه فارغًا للتطوير المحلي — يتراجع النظام تلقائيًا لحدّ في الذاكرة
# (كافٍ لسيرفر تطوير واحد فقط، غير موصى به للإنتاج الفعلي).
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# اختياري: لتفعيل "المتابعة عبر Google" (§4). Web OAuth Client ID من
# https://console.cloud.google.com/apis/credentials — يجب أن يطابق تمامًا
# قيمة serverClientId في lib/core/network/google_auth_config.dart بتطبيق
# Flutter. بدونه، /api/auth/google يرفض كل الطلبات بـ 503 واضح.
GOOGLE_CLIENT_ID=
